#: inc/pingvin-connector-settings-class.php:365
msgid "Sondersatz für Beherbergung in Bexio <p><small style=\"font-weight:400;\">MWST Code</small></p>"
msgstr "Aliquota speciale per l'alloggio in Bexio <p><small style=\"font-weight:400;\">Codice IVA</small></p>"

#: inc/pingvin-connector-settings-class.php:383
msgid "Sondersatz für Beherbergung in WooCommerce <p><small style=\"font-weight:400;\">Steuerklasse</small></p>"
msgstr "Aliquota speciale per l'alloggio in WooCommerce <p><small style=\"font-weight:400;\">Classe fiscale</small></p>"

#: inc/pingvin-connector-settings-class.php:391
msgid "Standard Bexio Benutzer <p><small style=\"font-weight:400;\">Wird für neue Bestellungen in Bexio verwendet.</small></p>"
msgstr "Utente Bexio predefinito <p><small style=\"font-weight:400;\">Utilizzato per i nuovi ordini in Bexio.</small></p>"

