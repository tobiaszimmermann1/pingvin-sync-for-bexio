#. Plugin Name of the plugin
#: pingvin-bexio-productsync.php
msgid "Pingvin Sync for Bexio"
msgstr "Pingvin Sync for Bexio"

#. Description of the plugin
#: pingvin-bexio-productsync.php
msgid "Connects WooCommerce to Bexio and syncs data between the two systems."
msgstr "Collega WooCommerce a Bexio e sincronizza i dati tra i due sistemi."

#. Author of the plugin
#: pingvin-bexio-productsync.php
msgid "Tobias Zimmermann"
msgstr "Tobias Zimmermann"

#. Author URI of the plugin
#: pingvin-bexio-productsync.php
msgid "https://pingvin.digital"
msgstr "https://pingvin.digital"

